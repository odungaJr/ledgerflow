# Copy this to .env in the same directory as docker-compose.yml.
# docker compose reads .env automatically for variable substitution below.

ANTHROPIC_API_KEY=sk-ant-xxxx
SECRET_KEY=change-me-in-production

# Origins allowed to call the backend API (comma-separated, no spaces).
CORS_ORIGINS=http://localhost:3000

# Baked into the frontend's client bundle at build time — must be reachable
# from the end user's browser, not just from inside the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:8000
