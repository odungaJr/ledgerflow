# Copy this to .env in the same directory as docker-compose.yml.
# docker compose reads .env automatically for variable substitution below.

ANTHROPIC_API_KEY=sk-ant-xxxx
SECRET_KEY=change-me-in-production

# Only relevant if you hit the backend directly (e.g. local dev without
# Caddy). Through the Caddy gateway, frontend/backend are same-origin, so
# CORS doesn't come into play.
CORS_ORIGINS=http://localhost:3000

# Baked into the frontend's client bundle at build time. Leave this as the
# relative "/api" for the normal Caddy-gated stack (docker compose up) — the
# browser calls the same origin it loaded the page from. Only set this to an
# absolute http://host:8000 if you're running frontend/backend directly
# without Caddy in front.
NEXT_PUBLIC_API_URL=/api

# HTTP Basic Auth gate in front of the whole stack (Caddy) — required before
# this is reachable from anywhere but your own machine.
BASIC_AUTH_USER=admin

# Generate with the command below (do NOT put a plaintext password here —
# Caddy requires a bcrypt hash). IMPORTANT: every "$" in the hash must be
# doubled to "$$", or docker compose's own .env interpolation will silently
# mangle it (it treats a bare "$word" as a variable reference and blanks it
# out if that "variable" isn't set) — the sed below does this escaping for
# you, so just copy its output directly:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password-here' | sed 's/\$/\$\$/g'
BASIC_AUTH_PASSWORD_HASH=
